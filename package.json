{
  "name": "didcomm-mediator",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.workers.json",
    "docker:build": "docker build -t ghcr.io/estoc-net/didcomm-mediator .",
    "dev:workers": "wrangler dev",
    "smoke": "tsx scripts/smoke.ts"
  },
  "author": "merely",
  "license": "Apache-2.0",
  "description": "A DIDComm v2 mediator anyone can run: coordinate-mediation/3.0, messagepickup/3.0, routing/2.0 over plain HTTP/WS transport",
  "dependencies": {
    "@estoc/did-peer": "^0.1.0",
    "@estoc/didcomm": "^0.4.1-estoc.3",
    "@estoc/didcomm-node": "^0.4.1-estoc.3",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "better-sqlite3": "^11.8.1",
    "bs58": "^6.0.0",
    "canonicalize": "^5.1.0",
    "did-resolver": "^4.1.0",
    "hono": "^4.13.1",
    "web-did-resolver": "^2.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "jose": "^6.2.12",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "ws": "^8.21.3"
  }
}
