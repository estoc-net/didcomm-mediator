{
  "name": "didcomm-mediator-ts",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t ghcr.io/estoc-net/didcomm-mediator-ts ."
  },
  "author": "merely",
  "license": "Apache-2.0",
  "description": "A DIDComm v2 mediator anyone can run: coordinate-mediation/3.0, messagepickup/3.0, routing/2.0 over plain HTTP/WS transport",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.8.1",
    "bs58": "^6.0.0",
    "did-resolver": "^4.1.0",
    "didcomm-node": "^0.4.1",
    "fastify": "^5.2.1",
    "web-did-resolver": "^2.0.27"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
