// Cloudflare Workers deployment of the mediator.
//
// Deploying by hand:
//   1. wrangler d1 create mediator   → paste database_id below
//   2. wrangler deploy
// (The "Deploy to Cloudflare" button does both for you, including the id.)
//
// There is nothing else: no secrets and no URL to configure. The mediator
// mints its keys into D1 on first contact and answers every host that routes
// to it — workers.dev, a custom domain added later, or both at once — as that
// host's own did:web. Attach custom domains in the dashboard rather than
// here, so this file stays deployable on any account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "didcomm-mediator",
  "main": "src/workers/index.ts",
  "compatibility_date": "2025-10-01",
  // Buffer and node:crypto in the shared protocol code.
  "compatibility_flags": ["nodejs_compat"],
  // The didcomm-node WASM build is Node-only; on workerd the bundler build
  // stands in through a small instantiation shim (same API, same wasm).
  "alias": {
    "didcomm-node": "./src/workers/didcomm-wasm.ts"
  },
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "InboxHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InboxHub"] }],
  // web stays the primary (advertised) name; the did:peer:2 alias answers
  // for clients whose correspondents cannot use a did:web routing DID —
  // demo.didcomm.org's resolver mangles JWK-material did:web documents.
  "vars": { "MEDIATOR_DID_METHODS": "web,peer2" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "didcomm-mediator",
      "database_id": "e57679e6-e700-46e9-abbf-a9b529a5a67d"
    }
  ],
  // Hourly purge of expired messages.
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  // Optional shape: keep public-folder object bytes in R2 instead of D1
  // blobs (recommended for anything beyond light publishing — D1 caps a
  // database at 500 MB on the free plan and the whole mediator shares it).
  // Not the default because enabling R2 requires a payment method on the
  // Cloudflare account even inside its free tier, and the one-click deploy
  // must not ask for one. To run it:
  //   wrangler r2 bucket create didcomm-mediator-objects
  //   wrangler deploy --env r2
  // Same worker, same database — just the extra binding, so switching on a
  // live deployment is safe (existing D1-blob objects keep serving). Once
  // on R2, keep deploying with --env r2: a plain deploy would drop the
  // binding and orphan the R2-held bytes (their rows would still claim
  // presence). Bindings aren't inherited into environments, so the D1 and
  // DO blocks are repeated here verbatim — keep them in sync.
  "env": {
    "r2": {
      "name": "didcomm-mediator",
      "vars": {
        "MEDIATOR_DID_METHODS": "web,peer2",
        // 4 MiB publication ceiling; the code default (16 MiB) is more than
        // this deployment wants to hold per DID.
        "MEDIATOR_MAX_PUBLICATION_BYTES": "4194304"
      },
      "durable_objects": {
        "bindings": [{ "name": "INBOX", "class_name": "InboxHub" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "didcomm-mediator",
          "database_id": "e57679e6-e700-46e9-abbf-a9b529a5a67d"
        }
      ],
      "r2_buckets": [
        { "binding": "PF_OBJECTS", "bucket_name": "didcomm-mediator-objects" }
      ]
    }
  }
}
